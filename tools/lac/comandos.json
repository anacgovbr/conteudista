{
  "$comentario": "Fonte única dos comandos, opções e atalhos da linha de comando (lac) e da API. Gera a ajuda do terminal, o manual (man), o autocompletar, docs/lac.md e, na etapa 11, o OpenAPI. Não duplique estes textos em outro lugar.",
  "programa": {
    "nome": "linguagem-acessivel",
    "atalho": "lac",
    "versao": "1.0.0",
    "titulo": "Linguagem Acessível",
    "descricao": "Confere acessibilidade e linguagem simples em textos Markdown.",
    "uso": "lac <comando> [opções] [arquivo...]",
    "entrada": "Sem arquivo, lê da entrada (pipe). Use - para a entrada."
  },
  "api": {
    "openapi": "3.1.0",
    "versao": "1.0.0",
    "rotasSistemicas": [
      { "metodo": "GET", "caminho": "/v1/saude", "descricao": "Informa se a API está disponível e suas versões." },
      { "metodo": "GET", "caminho": "/v1/openapi.json", "descricao": "Especificação OpenAPI 3.1 gerada dos comandos do lac." }
    ]
  },
  "comandos": [
    {
      "id": "conferir",
      "atalho": "c",
      "resumo": "Mostra o que corrigir e as sugestões",
      "descricao": "Confere um ou mais arquivos Markdown (ou a entrada) e lista o que corrigir e as sugestões, com linha e coluna. Sai com 1 se houver algo para corrigir; -f relatorio gera um relatório HTML.",
      "argumentos": "[arquivo...]",
      "opcoes": [
        "grupo",
        "regra",
        "nivel",
        "formato",
        "tipo",
        "limite",
        "config",
        "nome",
        "agrupar",
        "saida",
        "quieto"
      ],
      "formatos": [
        "texto",
        "json",
        "jsonl",
        "sarif",
        "resumo",
        "relatorio"
      ],
      "api": {
        "metodo": "POST",
        "caminho": "/v1/conferir[/{selecao}]"
      },
      "exemplos": [
        [
          "cat apostila.md | lac c",
          "tudo, para ler"
        ],
        [
          "lac c -g f -f jsonl apostila.md",
          "só frases, um item por linha"
        ],
        [
          "lac c -n c -q *.md",
          "nada para corrigir? (código de saída)"
        ],
        [
          "lac c -f sarif *.md -o achados.sarif",
          "para o GitHub"
        ]
      ]
    },
    {
      "id": "ajustar",
      "atalho": "a",
      "resumo": "Aplica as correções seguras e devolve o texto",
      "descricao": "Aplica só as correções que não mudam o sentido (por exemplo, o nível de um título) e devolve o texto corrigido. Descrever imagens e simplificar frases sempre precisam de uma pessoa.",
      "argumentos": "[arquivo]",
      "opcoes": [
        "grupo",
        "regra",
        "tipo",
        "config",
        "diferenca",
        "saida",
        "quieto"
      ],
      "formatos": [],
      "api": {
        "metodo": "POST",
        "caminho": "/v1/ajustar"
      },
      "exemplos": [
        [
          "lac a < rascunho.md > revisado.md",
          "aplica e grava em outro arquivo"
        ],
        [
          "lac a -d apostila.md",
          "mostra só o que mudaria"
        ]
      ]
    },
    {
      "id": "regras",
      "atalho": "r",
      "resumo": "Lista as regras",
      "descricao": "Lista as regras com código, nome, grupo e nível.",
      "argumentos": "",
      "opcoes": [
        "grupo",
        "formato"
      ],
      "formatos": [
        "texto",
        "json"
      ],
      "api": {
        "metodo": "GET",
        "caminho": "/v1/regras"
      },
      "exemplos": [
        [
          "lac r",
          "todas"
        ],
        [
          "lac r -g l",
          "só linguagem simples"
        ]
      ]
    },
    {
      "id": "explicar",
      "atalho": "e",
      "resumo": "Explica uma regra",
      "descricao": "Mostra o que a regra confere, por que importa, as correções e exemplos.",
      "argumentos": "<código ou nome>",
      "opcoes": [
        "formato"
      ],
      "formatos": [
        "texto",
        "json"
      ],
      "api": {
        "metodo": "GET",
        "caminho": "/v1/regras/{codigo}"
      },
      "exemplos": [
        [
          "lac e f1",
          "frase longa"
        ],
        [
          "lac e link-vago",
          "pelo nome"
        ]
      ],
      "curto": "lac e f1"
    },
    {
      "id": "pedido",
      "atalho": "p",
      "resumo": "Monta o pedido para IA",
      "descricao": "Monta o pedido padronizado (linguagem simples e boas práticas de acessibilidade) para colar na IA autorizada. simplificar: o trecho vem da entrada. descrever: a entrada, se houver, é o texto perto da imagem.",
      "argumentos": "<descrever|simplificar>",
      "opcoes": [
        "nome",
        "legenda",
        "saida"
      ],
      "formatos": [],
      "api": {
        "metodo": "POST",
        "caminho": "/v1/pedidos/{tipo}"
      },
      "exemplos": [
        [
          "lac p simplificar --nome \"Curso X\" < trecho.txt",
          "pedido para simplificar"
        ],
        [
          "lac p descrever --legenda \"Fluxo\" < contexto.txt",
          "pedido para descrever imagem"
        ]
      ],
      "curto": "lac p simplificar"
    },
    {
      "id": "servir",
      "atalho": "s",
      "resumo": "Abre a API neste computador",
      "descricao": "Inicia a API HTTP local. Use LAC_CORS_ORIGINS para configurar origens CORS; por padrão, só aceita chamadas locais.",
      "argumentos": "[-p porta]",
      "opcoes": ["porta"],
      "formatos": [],
      "exemplos": [["lac s -p 8080", "inicia a API local na porta 8080"]]
    },
    {
      "id": "ajuda",
      "atalho": "h",
      "resumo": "Ajuda de um comando",
      "descricao": "Mostra a ajuda geral ou a de um comando.",
      "argumentos": "[comando]",
      "opcoes": [],
      "formatos": [],
      "api": {
        "metodo": "GET",
        "caminho": "/v1/ajuda[/{comando}]"
      },
      "exemplos": [
        [
          "lac h c",
          "ajuda do conferir"
        ]
      ],
      "curto": "lac h c"
    },
    {
      "id": "completar",
      "atalho": "",
      "resumo": "Autocompletar para bash ou zsh",
      "descricao": "Mostra o script de autocompletar. No bash: source <(lac completar bash).",
